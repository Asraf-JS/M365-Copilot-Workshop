createOrReplace

    model Model
        culture: en-US
        defaultPowerBIDataSourceVersion: powerBI_V3
        sourceQueryCulture: en-MY
        dataAccessOptions
            legacyRedirects
            returnErrorValuesAsNull

        table cars
            lineageTag: 14ebcaeb-bf51-4987-b428-82610b9870ff

            column 'Registration Date'
                dataType: dateTime
                formatString: Long Date
                lineageTag: 92596e48-929e-4f24-8f2b-06667430b5d0
                summarizeBy: none
                sourceColumn: Registration Date

                annotation SummarizationSetBy = Automatic

                annotation UnderlyingDateTimeDataType = Date

            column Year
                dataType: int64
                formatString: 0
                lineageTag: b94fc216-6460-4311-903c-e2ee0d31b1ee
                summarizeBy: none
                sourceColumn: Year

                annotation SummarizationSetBy = User

            column 'Month Number'
                dataType: int64
                formatString: 0
                lineageTag: 831e9b87-8062-4bd0-8e49-ba03531ed8ae
                summarizeBy: none
                sourceColumn: Month Number

                annotation SummarizationSetBy = User

            column 'Month Name'
                dataType: string
                lineageTag: 889df923-ae2e-4b32-aa72-b2e9ecc96b6c
                summarizeBy: none
                sourceColumn: Month Name
                sortByColumn: 'Month Number'

                annotation SummarizationSetBy = Automatic

            column Year-Month
                dataType: string
                lineageTag: 13c3b116-afff-4954-ac96-7fe8c726016b
                summarizeBy: none
                sourceColumn: Year-Month

                annotation SummarizationSetBy = Automatic

            column 'Source Year'
                dataType: int64
                formatString: 0
                lineageTag: 72288340-c0c8-4b92-8875-d2029777dd8b
                summarizeBy: none
                sourceColumn: Source Year

                annotation SummarizationSetBy = User

            column 'Vehicle Type'
                dataType: string
                lineageTag: 6f9d5db1-5296-4b5f-b4b3-6c5455fa15ea
                summarizeBy: none
                sourceColumn: Vehicle Type

                annotation SummarizationSetBy = Automatic

            column 'Vehicle Type Group'
                dataType: string
                lineageTag: 6bb563f1-c86b-4082-9eab-0980ce95b40e
                summarizeBy: none
                sourceColumn: Vehicle Type Group

                annotation SummarizationSetBy = Automatic

            column Maker
                dataType: string
                lineageTag: b2c6bd36-a990-4c64-b907-7a9aae6e8b0d
                summarizeBy: none
                sourceColumn: Maker

                annotation SummarizationSetBy = Automatic

            column Model
                dataType: string
                lineageTag: 5f555d84-5119-4cfc-b390-d5360b66e00a
                summarizeBy: none
                sourceColumn: Model

                annotation SummarizationSetBy = Automatic

            column Colour
                dataType: string
                lineageTag: 2534a11e-f075-4184-91a7-e6b5c1326068
                summarizeBy: none
                sourceColumn: Colour

                annotation SummarizationSetBy = Automatic

            column 'Fuel Type'
                dataType: string
                lineageTag: 43a07bd5-35a7-454e-ad82-06ceeca9814b
                summarizeBy: none
                sourceColumn: Fuel Type

                annotation SummarizationSetBy = Automatic

            column 'Fuel Group'
                dataType: string
                lineageTag: 172d1476-867c-4435-9dce-586dcbec0af8
                summarizeBy: none
                sourceColumn: Fuel Group

                annotation SummarizationSetBy = Automatic

            column State
                dataType: string
                lineageTag: e8631a9d-48d5-4298-8d0b-3651980c4b66
                summarizeBy: none
                sourceColumn: State

                annotation SummarizationSetBy = Automatic

            column 'State Type'
                dataType: string
                lineageTag: 2f6a7f2f-9aff-48b0-8388-938199f80579
                summarizeBy: none
                sourceColumn: State Type

                annotation SummarizationSetBy = Automatic

            column 'Registration Count'
                dataType: int64
                formatString: 0
                lineageTag: 21df0734-5455-4b4a-bcfb-9721befa3968
                summarizeBy: sum
                sourceColumn: Registration Count

                annotation SummarizationSetBy = Automatic

            measure 'Total Registrations' =
                    
                    SUM ( 'cars'[Registration Count] )
                formatString: #,0
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1001

            measure 'EV Registrations' =
                    
                    CALCULATE (
                        'cars'[Total Registrations],
                        'cars'[Fuel Group] = "Electric"
                    )
                formatString: #,0
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1002

            measure 'Hybrid Registrations' =
                    
                    CALCULATE (
                        'cars'[Total Registrations],
                        'cars'[Fuel Group] = "Hybrid"
                    )
                formatString: #,0
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1003

            measure 'Electrified Vehicle Registrations' =
                    
                    CALCULATE (
                        'cars'[Total Registrations],
                        'cars'[Fuel Group] IN { "Electric", "Hybrid" }
                    )
                formatString: #,0
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1004

            measure 'Petrol Registrations' =
                    
                    CALCULATE (
                        'cars'[Total Registrations],
                        'cars'[Fuel Group] = "Petrol"
                    )
                formatString: #,0
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1005

            measure 'Diesel Registrations' =
                    
                    CALCULATE (
                        'cars'[Total Registrations],
                        'cars'[Fuel Group] = "Diesel"
                    )
                formatString: #,0
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1006

            measure 'Non-EV Registrations' =
                    
                    CALCULATE (
                        'cars'[Total Registrations],
                        'cars'[Fuel Group] <> "Electric"
                    )
                formatString: #,0
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1007

            measure 'EV Share' =
                    
                    DIVIDE (
                        'cars'[EV Registrations],
                        'cars'[Total Registrations]
                    )
                formatString: 0.00%
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1008

            measure 'Hybrid Share' =
                    
                    DIVIDE (
                        'cars'[Hybrid Registrations],
                        'cars'[Total Registrations]
                    )
                formatString: 0.00%
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1009

            measure 'Electrified Vehicle Share' =
                    
                    DIVIDE (
                        'cars'[Electrified Vehicle Registrations],
                        'cars'[Total Registrations]
                    )
                formatString: 0.00%
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1010

            measure 'EV to Non-EV Ratio' =
                    
                    DIVIDE (
                        'cars'[EV Registrations],
                        'cars'[Non-EV Registrations]
                    )
                formatString: 0.00
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1011

            measure 'EV Rank by State' =
                    
                    RANKX (
                        ALL ( 'cars'[State] ),
                        'cars'[EV Registrations],
                        ,
                        DESC,
                        Dense
                    )
                formatString: 0
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1012

            measure 'EV Rank by Maker' =
                    
                    RANKX (
                        ALL ( 'cars'[Maker] ),
                        'cars'[EV Registrations],
                        ,
                        DESC,
                        Dense
                    )
                formatString: 0
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1013

            measure 'EV Registrations Previous Year' =
                    
                    VAR CurrentYear =
                        SELECTEDVALUE ( 'cars'[Year] )
                    RETURN
                        CALCULATE (
                            'cars'[EV Registrations],
                            FILTER (
                                ALL ( 'cars'[Year] ),
                                'cars'[Year] = CurrentYear - 1
                            )
                        )
                formatString: #,0
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1014

            measure 'EV Growth YoY' =
                    
                    'cars'[EV Registrations] - 'cars'[EV Registrations Previous Year]
                formatString: #,0
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1015

            measure 'EV Growth % YoY' =
                    
                    DIVIDE (
                        'cars'[EV Growth YoY],
                        'cars'[EV Registrations Previous Year]
                    )
                formatString: 0.00%
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1016

            measure 'EV Share Previous Year' =
                    
                    VAR CurrentYear =
                        SELECTEDVALUE ( 'cars'[Year] )
                    RETURN
                        CALCULATE (
                            'cars'[EV Share],
                            FILTER (
                                ALL ( 'cars'[Year] ),
                                'cars'[Year] = CurrentYear - 1
                            )
                        )
                formatString: 0.00%
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1017

            measure 'EV Share Change' =
                    
                    'cars'[EV Share] - 'cars'[EV Share Previous Year]
                formatString: 0.00%
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1018

            measure 'EV Share Change Percentage Points' =
                    
                    'cars'[EV Share Change] * 100
                formatString: 0.00
                lineageTag: 5d8f2b2b-9a5f-4e70-9a62-1a4f1b5e1019

            partition cars = m
                mode: import
                source =
                        let
                            // =====================================================
                            // 1. Define year range
                            // =====================================================
                            StartYear = 2020,
                            EndYear = 2026,
                        
                            YearList = {StartYear..EndYear},
                        
                            // =====================================================
                            // 2. Create function to load one year of data
                            // =====================================================
                            GetCarsByYear = (Year as number) as table =>
                                let
                                    FileName = "cars_" & Text.From(Year) & ".csv",
                        
                                    Source = Csv.Document(
                                        Web.Contents(
                                            "https://storage.data.gov.my",
                                            [
                                                RelativePath = "transportation/" & FileName
                                            ]
                                        ),
                                        [
                                            Delimiter = ",",
                                            Columns = 7,
                                            Encoding = 1252,
                                            QuoteStyle = QuoteStyle.None
                                        ]
                                    ),
                        
                                    #"Promoted Headers" = Table.PromoteHeaders(
                                        Source,
                                        [PromoteAllScalars = true]
                                    ),
                        
                                    #"Changed Type" = Table.TransformColumnTypes(
                                        #"Promoted Headers",
                                        {
                                            {"date_reg", type date},
                                            {"type", type text},
                                            {"maker", type text},
                                            {"model", type text},
                                            {"colour", type text},
                                            {"fuel", type text},
                                            {"state", type text}
                                        }
                                    ),
                        
                                    #"Added Source Year" = Table.AddColumn(
                                        #"Changed Type",
                                        "Source Year",
                                        each Year,
                                        Int64.Type
                                    )
                                in
                                    #"Added Source Year",
                        
                            // =====================================================
                            // 3. Load all yearly files
                            // =====================================================
                            TablesByYear = List.Transform(
                                YearList,
                                each GetCarsByYear(_)
                            ),
                        
                            // =====================================================
                            // 4. Combine all yearly tables
                            // =====================================================
                            #"Combined Tables" = Table.Combine(TablesByYear),
                        
                            // =====================================================
                            // 5. Trim text columns
                            // =====================================================
                            #"Trimmed Text" = Table.TransformColumns(
                                #"Combined Tables",
                                {
                                    {"type", Text.Trim, type text},
                                    {"maker", Text.Trim, type text},
                                    {"model", Text.Trim, type text},
                                    {"colour", Text.Trim, type text},
                                    {"fuel", Text.Trim, type text},
                                    {"state", Text.Trim, type text}
                                }
                            ),
                        
                            // =====================================================
                            // 6. Replace underscores with spaces
                            // =====================================================
                            #"Replaced Underscores" = Table.ReplaceValue(
                                #"Trimmed Text",
                                "_",
                                " ",
                                Replacer.ReplaceText,
                                {"type", "fuel"}
                            ),
                        
                            // =====================================================
                            // 7. Format selected text columns
                            // Maker and model are excluded to preserve values like BMW, GAC, GS3, iCaur V23
                            // =====================================================
                            #"Formatted Text" = Table.TransformColumns(
                                #"Replaced Underscores",
                                {
                                    {"type", Text.Proper, type text},
                                    {"colour", Text.Proper, type text},
                                    {"fuel", Text.Proper, type text},
                                    {"state", Text.Proper, type text}
                                }
                            ),
                        
                            // =====================================================
                            // 8. Add date analysis columns
                            // =====================================================
                            #"Added Year" = Table.AddColumn(
                                #"Formatted Text",
                                "Year",
                                each Date.Year([date_reg]),
                                Int64.Type
                            ),
                        
                            #"Added Month Number" = Table.AddColumn(
                                #"Added Year",
                                "Month Number",
                                each Date.Month([date_reg]),
                                Int64.Type
                            ),
                        
                            #"Added Month Name" = Table.AddColumn(
                                #"Added Month Number",
                                "Month Name",
                                each Date.MonthName([date_reg]),
                                type text
                            ),
                        
                            #"Added Year-Month" = Table.AddColumn(
                                #"Added Month Name",
                                "Year-Month",
                                each Date.ToText([date_reg], "yyyy-MM"),
                                type text
                            ),
                        
                            // =====================================================
                            // 9. Add registration count column
                            // Each row represents one vehicle registration
                            // =====================================================
                            #"Added Registration Count" = Table.AddColumn(
                                #"Added Year-Month",
                                "Registration Count",
                                each 1,
                                Int64.Type
                            ),
                        
                            // =====================================================
                            // 10. Add broader fuel group
                            // =====================================================
                            #"Added Fuel Group" = Table.AddColumn(
                                #"Added Registration Count",
                                "Fuel Group",
                                each
                                    if [fuel] = null then "Unknown"
                                    else if Text.Contains([fuel], "Electric", Comparer.OrdinalIgnoreCase) then "Electric"
                                    else if Text.Contains([fuel], "Hybrid", Comparer.OrdinalIgnoreCase) then "Hybrid"
                                    else if Text.Contains([fuel], "Petrol", Comparer.OrdinalIgnoreCase) then "Petrol"
                                    else if Text.Contains([fuel], "Diesel", Comparer.OrdinalIgnoreCase) then "Diesel"
                                    else "Other",
                                type text
                            ),
                        
                            // =====================================================
                            // 11. Add state type
                            // This separates Malaysian states from non-state categories such as Rakan Niaga
                            // =====================================================
                            MalaysianStates = {
                                "Johor",
                                "Kedah",
                                "Kelantan",
                                "Melaka",
                                "Negeri Sembilan",
                                "Pahang",
                                "Perak",
                                "Perlis",
                                "Pulau Pinang",
                                "Sabah",
                                "Sarawak",
                                "Selangor",
                                "Terengganu",
                                "W.P. Kuala Lumpur",
                                "W.P. Labuan",
                                "W.P. Putrajaya"
                            },
                        
                            #"Added State Type" = Table.AddColumn(
                                #"Added Fuel Group",
                                "State Type",
                                each
                                    if List.Contains(MalaysianStates, [state]) then "State"
                                    else "Non-State / Other",
                                type text
                            ),
                        
                            // =====================================================
                            // 12. Add business-friendly vehicle type group
                            // =====================================================
                            #"Added Vehicle Type Group" = Table.AddColumn(
                                #"Added State Type",
                                "Vehicle Type Group",
                                each
                                    if [type] = null then "Unknown"
                                    else if [type] = "Motokar" then "Passenger Car"
                                    else if [type] = "Jip" then "SUV / Jeep"
                                    else if [type] = "Pick Up" then "Pickup Truck"
                                    else [type],
                                type text
                            ),
                        
                            // =====================================================
                            // 13. Rename columns for reporting
                            // =====================================================
                            #"Renamed Columns" = Table.RenameColumns(
                                #"Added Vehicle Type Group",
                                {
                                    {"date_reg", "Registration Date"},
                                    {"type", "Vehicle Type"},
                                    {"maker", "Maker"},
                                    {"model", "Model"},
                                    {"colour", "Colour"},
                                    {"fuel", "Fuel Type"},
                                    {"state", "State"}
                                }
                            ),
                        
                            // =====================================================
                            // 14. Reorder columns
                            // =====================================================
                            #"Reordered Columns" = Table.ReorderColumns(
                                #"Renamed Columns",
                                {
                                    "Registration Date",
                                    "Year",
                                    "Month Number",
                                    "Month Name",
                                    "Year-Month",
                                    "Source Year",
                                    "Vehicle Type",
                                    "Vehicle Type Group",
                                    "Maker",
                                    "Model",
                                    "Colour",
                                    "Fuel Type",
                                    "Fuel Group",
                                    "State",
                                    "State Type",
                                    "Registration Count"
                                }
                            )
                        in
                            #"Reordered Columns"

            annotation PBI_NavigationStepName = Navigation

            annotation PBI_ResultType = Table

        cultureInfo en-US

        annotation __PBI_TimeIntelligenceEnabled = 1

        annotation PBI_QueryOrder = ["cars"]
